#!/bin/bash
# Auto-bump patch version in manifest.json before each commit.
# Version format: MAJOR.MINOR.PATCH -> PATCH += 1

MANIFEST="manifest.json"

# Only bump if manifest.json exists in the repo root
if [ ! -f "$MANIFEST" ]; then
  exit 0
fi

# Extract current version
CURRENT_VERSION=$(grep -o '"version": *"[^"]*"' "$MANIFEST" | head -1 | grep -o '[0-9]\+\.[0-9]\+\.[0-9]\+')

if [ -z "$CURRENT_VERSION" ]; then
  echo "Warning: Could not parse version from $MANIFEST, skipping auto-bump."
  exit 0
fi

# Split version
MAJOR=$(echo "$CURRENT_VERSION" | cut -d. -f1)
MINOR=$(echo "$CURRENT_VERSION" | cut -d. -f2)
PATCH=$(echo "$CURRENT_VERSION" | cut -d. -f3)

# Bump patch
NEW_PATCH=$((PATCH + 1))
NEW_VERSION="$MAJOR.$MINOR.$NEW_PATCH"

# Replace in manifest.json (macOS sed compatible)
sed -i '' "s/\"version\": *\"$CURRENT_VERSION\"/\"version\": \"$NEW_VERSION\"/" "$MANIFEST"

# Stage the updated manifest
git add "$MANIFEST"

echo "Version bumped: $CURRENT_VERSION -> $NEW_VERSION"
